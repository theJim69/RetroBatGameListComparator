<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Version -->
    <Version>1.5.1-dev</Version>
    <AssemblyVersion>1.5.1.0</AssemblyVersion>
    <FileVersion>1.5.1.0</FileVersion>
    <InformationalVersion>1.5.1-dev</InformationalVersion>

    <!-- Informations -->
    <Company>theJim</Company>
    <Product>RetroBat GameList Comparator</Product>
    <Authors>theJim</Authors>
    <Copyright>© 2026 theJim</Copyright>
    <Description>Compare RetroBat ROM folders with gamelist.xml while supporting Hidden and MultiDisk games.</Description>

  </PropertyGroup>

  <ItemGroup>
    <None Remove="Data\Extensions.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\Extensions.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\RetroBatGameListComparator.ico" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Exports\" />
  </ItemGroup>

</Project>